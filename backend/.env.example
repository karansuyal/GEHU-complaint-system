# Copy to .env (backend/.env). Everything except the values marked REQUIRED has a default.

# ---- Environment ----
# production | development | auto. "auto" = production whenever DATABASE_URL is not SQLite.
ENVIRONMENT=auto

# ---- Database ----
# Local dev: SQLite needs no setup. Production: use Postgres, e.g.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./complaints.db

# ---- Security ----
# REQUIRED in production (>= 32 chars, the app refuses to start otherwise). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Your deployed frontend URL (CORS). No trailing slash.
FRONTEND_ORIGIN=http://localhost:5173

# Rate limiting (in-memory, per process). Set TRUST_PROXY_HEADERS=true ONLY when running
# behind a reverse proxy such as Render/Railway/Nginx, so the real client IP is used.
RATE_LIMIT_ENABLED=true
TRUST_PROXY_HEADERS=false

# ---- Campus / SLA ----
CAMPUS_NAME=bhimtal
ESCALATION_SLA_HOURS=48
RAGGING_ESCALATION_SLA_HOURS=6
REOPEN_WINDOW_DAYS=7
# With several workers/instances, set this to false on all but one of them.
RUN_SCHEDULER=true

# ---- Photo uploads (Cloudinary). Without these, filing a complaint WITH a photo returns a clear error. ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_UPLOAD_MB=8

# ---- Email ----
# Only college addresses may register, e.g. gehu.ac.in (empty = anyone).
ALLOWED_EMAIL_DOMAINS=
REQUIRE_EMAIL_VERIFICATION=true
# Brevo (recommended). With both BREVO_API_KEY and SMTP_HOST empty, emails print to the console.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=GEHU Complaint Portal
EMAIL_REPLY_TO=
# Optional SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false

# ---- Web push (python generate_vapid_keys.py). Blank = push disabled, in-app bell still works. ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=admin@gehu.ac.in
